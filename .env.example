VITE_SUPABASE_URL=https://your-project.supabase.co
# Public client key: the anon key or the newer publishable key (sb_publishable_…).
VITE_SUPABASE_ANON_KEY=your-anon-key
# (alias accepted: VITE_SUPABASE_PUBLISHABLE_KEY)
#
# NEVER put the secret key (sb_secret_…) in the frontend or in this file — it
# bypasses Row Level Security. It is only for a trusted server/Edge Function.

# Supabase is optional. With these set, every admin edit (site copy, projects,
# uploads, disciplines, reviews) is stored in the shared backend and therefore
# shows up in every browser and device. Without them the site runs in demo mode
# and stores everything in this browser only (IndexedDB), so edits are NOT
# visible anywhere else.
#
# The un-prefixed names SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY
# are also accepted, for hosts that only expose plain environment variables —
# but note Vite only injects VITE_-prefixed vars into the browser bundle.
# Keep Row Level Security enabled (see supabase/schema.sql) so only signed-in
# admins can write.
